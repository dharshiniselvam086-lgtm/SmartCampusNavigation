<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
    version="3.1">

    <!-- Campus Servlet -->
    <servlet>
        <servlet-name>CampusServlet</servlet-name>
        <servlet-class>controller.CampusServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CampusServlet</servlet-name>
        <url-pattern>/campus</url-pattern>
    </servlet-mapping>


    <!-- Location Search Servlet -->
    <servlet>
        <servlet-name>LocationSearchServlet</servlet-name>
        <servlet-class>controller.LocationSearchServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LocationSearchServlet</servlet-name>
        <url-pattern>/searchLocation</url-pattern>
    </servlet-mapping>


    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>


    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>


    <!-- XPath Servlet -->
    <servlet>
        <servlet-name>XPathServlet</servlet-name>
        <servlet-class>controller.XPathServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>XPathServlet</servlet-name>
        <url-pattern>/xpath</url-pattern>
    </servlet-mapping>


    <!-- Route Servlet -->
    <servlet>
        <servlet-name>RouteServlet</servlet-name>
        <servlet-class>controller.RouteServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RouteServlet</servlet-name>
        <url-pattern>/route</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LocationDetailsServlet</servlet-name>
        <servlet-class>controller.LocationDetailsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LocationDetailsServlet</servlet-name>
        <url-pattern>/locationDetails</url-pattern>
    </servlet-mapping>


    <!-- Welcome Page -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>